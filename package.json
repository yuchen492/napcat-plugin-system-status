{
  "name": "napcat-plugin-system-status",
  "plugin": "系统状态",
  "version": "1.0.0",
  "type": "module",
  "main": "index.mjs",
  "description": "NapCatQQ 系统运行状态监控插件（支持资源占用、虚拟化架构、IP脱敏、机房归属、白名单与自身消息触发）",
  "author": "YunBai",
  "license": "MIT",
  "keywords": [
    "napcat",
    "plugin",
    "qq",
    "system-status",
    "monitor"
  ],
  "napcat": {
    "tags": [
      "工具",
      "监控"
    ],
    "minVersion": "4.14.0",
    "homepage": ""
  },
  "dependencies": {
    "napcat-types": "0.0.16"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.33",
    "napcat-plugin-debug-cli": "^1.2.8",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "ws": "^8.19.0"
  },
  "scripts": {
    "build": "vite build",
    "build:webui": "cd src/webui && npm install && npm run build",
    "dev:webui": "cd src/webui && npm run dev",
    "watch": "vite build --watch",
    "dev": "vite build --watch",
    "deploy": "vite build",
    "typecheck": "tsc --noEmit"
  }
}
